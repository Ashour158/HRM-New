# HR/HCM Platform — Local Development Environment

# Database
DATABASE_URL=postgresql://hcm_admin:hcm_dev_password@localhost:5434/hcm_platform

# Cache
REDIS_URL=redis://localhost:6380

# Message Bus
KAFKA_BROKERS=localhost:19092

# Security
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=12h
REFRESH_TOKEN_EXPIRES_IN=7d
MFA_REQUIRED=false
BCRYPT_COST=12
LOGIN_MAX_ATTEMPTS=5
LOCKOUT_MINUTES=15
API_KEY_HEADER=X-API-Key
SYSTEM_API_KEY=system-api-key
INTEGRATION_API_KEY=integration-api-key
ENCRYPTION_KEY_ID=dev-local-key
# 32-byte base64 key for AES-256-GCM SSO IdP secret encryption (local dev sample only)
SSO_SECRET_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
# 32-byte base64 key for AES-256-GCM encryption of BANKING/TAX/COMPENSATION and
# SPECIAL_CATEGORY personal data at rest (local dev sample only). Required in
# production/staging -- see packages/hr-platform-core/src/crypto/pii-encryption.ts.
PII_DATA_ENCRYPTION_KEY=6Gdqn+NboETtSLaJops/j6t7wmS40R+YsQ7i2DsgRf4=

# Optional identity provider metadata
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_REDIRECT_URI=
SAML_METADATA_URL=
SAML_ENTITY_ID=

# API Server
PORT=3001
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# Canonical frontend origin SSO callbacks redirect to (server-configured --
# never derived from a client-supplied header). Falls back to the first
# CORS_ORIGINS entry, then localhost:4173, if unset.
WEB_APP_URL=http://localhost:4173

# Frontend API target
VITE_API_BASE_URL=http://localhost:3001/api/v1
VITE_AUTH_BYPASS=false

# Optional
LOG_LEVEL=info
NODE_ENV=development

# Observability
# OTEL_ENABLED forces tracing on; otherwise tracing auto-starts when an OTLP
# endpoint is set below (and stays off when neither is configured).
OTEL_ENABLED=false
OTEL_SERVICE_NAME=hr-api
OTEL_EXPORTER_OTLP_ENDPOINT=

# Rate limiting (global per-IP throttle)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=300
# THROTTLE_REDIS=true uses REDIS_URL for shared cross-replica limit state (prod);
# default keeps an in-memory per-process store.
THROTTLE_REDIS=false

# Row-Level Security (defense-in-depth multi-tenancy). See infra/rls/README.md.
# Enable only with a non-superuser app role; route background jobs at the system role.
DB_RLS_ENABLED=false
# SYSTEM_DATABASE_URL: BYPASSRLS connection (hcm_system) for cross-tenant background
# work. Falls back to DATABASE_URL when unset.
SYSTEM_DATABASE_URL=
