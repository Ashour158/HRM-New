# HR/HCM Platform — Local Development Environment

# Database
DATABASE_URL=postgresql://hcm_admin:hcm_dev_password@localhost:5434/hcm_platform

# Cache
REDIS_URL=redis://localhost:6380

# Message Bus
KAFKA_BROKERS=localhost:19092

# Security
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=12h
REFRESH_TOKEN_EXPIRES_IN=7d
MFA_REQUIRED=false
MFA_DEMO_CODE=123456
API_KEY_HEADER=X-API-Key
SYSTEM_API_KEY=system-api-key
INTEGRATION_API_KEY=integration-api-key
ENCRYPTION_KEY_ID=dev-local-key

# Optional identity provider metadata
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_REDIRECT_URI=
SAML_METADATA_URL=
SAML_ENTITY_ID=

# Email notification integration
# DISABLED keeps email off, LOG records sends without external delivery, WEBHOOK posts to the configured provider endpoint.
HR_EMAIL_NOTIFICATIONS_ENABLED=false
HR_EMAIL_DELIVERY_MODE=DISABLED
HR_EMAIL_WEBHOOK_URL=
HR_EMAIL_WEBHOOK_TOKEN=
HR_EMAIL_FROM=hrm-nexus@example.com
HR_OPERATIONS_EMAILS=

# API Server
PORT=3001
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Frontend API target
VITE_API_BASE_URL=http://localhost:3001/api/v1
VITE_AUTH_BYPASS=true

# Optional
LOG_LEVEL=info
NODE_ENV=development

# Observability
OTEL_ENABLED=false
OTEL_SERVICE_NAME=hr-api
OTEL_EXPORTER_OTLP_ENDPOINT=
