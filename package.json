{
  "name": "hr-hcm-platform",
  "version": "1.4.0",
  "packageManager": "pnpm@9.15.9",
  "private": true,
  "description": "Enterprise HR/HCM SaaS Platform — Full-Stack Implementation",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "secret:scan": "node scripts/secret-scan.mjs",
    "locale:scan": "node scripts/locale-scan.mjs",
    "ci:verify-deployment-envelope": "node scripts/verify-deployment-envelope.mjs",
    "runtime:smoke": "node scripts/runtime-smoke.mjs",
    "runtime:golden-workflow": "node scripts/golden-workflow-smoke.mjs",
    "db:migrate": "pnpm exec dotenv -e .env -- pnpm --filter @hcm/database migrate",
    "db:migrate:create": "pnpm exec dotenv -e .env -- pnpm --filter @hcm/database migrate:create",
    "db:seed": "pnpm exec dotenv -e .env -- pnpm --filter @hcm/database seed",
    "api:start": "pnpm exec dotenv -e .env -- pnpm --filter @hcm/hr-api start:dev",
    "web:dev": "pnpm exec dotenv -e .env -- pnpm --filter hr-web dev",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^1.6.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^8.57.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.2.0",
    "turbo": "^2.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.6.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,json,md}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "kysely": "^0.28.17",
      "lodash": "^4.18.1",
      "multer": "^2.1.1",
      "tar": "^7.5.11",
      "glob@10.4.5": "10.5.0",
      "form-data@>=4.0.0 <4.0.6": ">=4.0.6"
    }
  }
}
