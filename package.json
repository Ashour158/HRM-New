{
  "name": "hr-hcm-platform",
  "version": "1.4.0",
  "packageManager": "pnpm@9.15.9",
  "private": true,
  "description": "Enterprise HR/HCM SaaS Platform — Full-Stack Implementation",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "secret:scan": "node scripts/secret-scan.mjs",
    "dependency:audit": "node scripts/dependency-audit.mjs",
    "locale:scan": "node scripts/locale-scan.mjs",
    "check:no-compiled-output-in-src": "node scripts/check-no-compiled-output-in-src.mjs",
    "ci:verify-deployment-envelope": "node scripts/verify-deployment-envelope.mjs",
    "test:build-tooling": "node --test scripts/verify-tsc-output.test.mjs",
    "runtime:smoke": "node scripts/runtime-smoke.mjs",
    "runtime:golden-workflow": "node scripts/golden-workflow-smoke.mjs",
    "db:migrate": "pnpm exec dotenv -e .env -- pnpm --filter @hcm/database migrate",
    "db:migrate:create": "pnpm exec dotenv -e .env -- pnpm --filter @hcm/database migrate:create",
    "db:seed": "pnpm exec dotenv -e .env -- pnpm --filter @hcm/database seed",
    "db:backup": "pnpm exec dotenv -e .env -- node scripts/backup/pg-backup.mjs",
    "db:restore-drill": "pnpm exec dotenv -e .env -- node scripts/backup/pg-restore-drill.mjs",
    "load:smoke": "node scripts/load/smoke.mjs",
    "api:start": "pnpm exec dotenv -e .env -- pnpm --filter @hcm/hr-api start:dev",
    "web:dev": "pnpm exec dotenv -e .env -- pnpm --filter hr-web dev",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.8.0",
    "husky": "^9.0.0",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.7",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,json,md}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "kysely": "^0.28.17",
      "lodash": "^4.18.1",
      "multer": "^2.2.0",
      "hono": ">=4.12.25",
      "tar": "^7.5.11",
      "glob": ">=11.1.0",
      "form-data@>=4.0.0 <4.0.6": ">=4.0.6",
      "vitest": "4.1.10",
      "@vitest/coverage-v8": "4.1.10",
      "vite": ">=6.4.3 <7",
      "tmp": ">=0.2.6",
      "minimatch": ">=9.0.6",
      "picomatch": ">=4.0.4 <5",
      "js-yaml": ">=4.2.0 <5",
      "file-type": ">=21.3.2 <22",
      "uuid": ">=11.1.1 <12",
      "qs": ">=6.15.2 <7",
      "protobufjs": ">=7.6.3 <8",
      "@opentelemetry/core": ">=2.8.0 <3"
    }
  }
}
