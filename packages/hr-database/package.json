{
  "name": "@hcm/database",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "migrate": "node-pg-migrate up --migrations-dir ../../infra/migrations",
    "migrate:create": "node-pg-migrate create --migrations-dir ../../infra/migrations",
    "seed": "node dist/seed.js",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src/**/*.ts"
  },
  "dependencies": {
    "@hcm/shared-kernel": "workspace:*",
    "kysely": "^0.28.17",
    "pg": "^8.11.0",
    "pg-pool": "^3.6.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0",
    "@types/pg-pool": "^2.0.6",
    "kysely-codegen": "^0.15.0",
    "node-pg-migrate": "^7.5.0",
    "typescript": "^5.3.0",
    "vitest": "^1.6.0"
  }
}
