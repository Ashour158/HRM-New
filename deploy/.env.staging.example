# Example environment file for running a staging-like stack locally with
# deploy/docker-compose.production.yml (yes, that filename — see
# docs/staging-environment-setup.md for why there's no separate
# docker-compose.staging.yml: the compose file is already environment-neutral
# and parameterized by env vars, so staging reuses it with a different .env
# instead of duplicating it).
#
# Usage:
#   cp deploy/.env.staging.example deploy/.env.staging
#   # edit deploy/.env.staging and replace every replace-me value below
#   docker compose -f deploy/docker-compose.production.yml --env-file deploy/.env.staging up --build
#
# This is for a developer's local "staging-like" smoke test (no real cluster,
# no real domain) — it is NOT the same thing as the real staging K8s
# environment under deploy/k8s/overlays/staging/. Ports are offset from the
# usual local-dev defaults (3001/8088) so this can run alongside a normal dev
# stack without colliding.

POSTGRES_USER=hcm_admin
POSTGRES_PASSWORD=replace-me-local-only-password
POSTGRES_DB=hcm_platform

# Any non-empty value works locally; this is not a production secret.
JWT_SECRET=replace-me-local-only-jwt-secret
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d
MFA_REQUIRED=false

# ENCRYPTION_KEY_ID identifies a key in whatever KMS/secrets-manager the app
# is configured against; for a local smoke run a placeholder is fine as long
# as the code paths that actually encrypt/decrypt aren't being exercised.
ENCRYPTION_KEY_ID=replace-me-local-only-key-id

# Leave OIDC_*/SAML_* blank to keep SSO disabled for a local run.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_REDIRECT_URI=
SAML_METADATA_URL=
SAML_ENTITY_ID=

CORS_ORIGINS=http://localhost:8188

OTEL_ENABLED=false
OTEL_SERVICE_NAME=hr-api
OTEL_EXPORTER_OTLP_ENDPOINT=

# Offset from the 3001/8088 local-dev defaults on purpose (see header comment).
API_PORT=3101
WEB_PORT=8188

# Leave unset to build local images from apps/*/Dockerfile (the compose
# file's default). Set these to a ghcr.io tag instead if you want to smoke
# test an already-built candidate image without rebuilding, e.g. the same
# tag deploy-staging.yml just pushed:
#   HCM_API_IMAGE=ghcr.io/your-org/hr-hcm-api:staging-latest
#   HCM_WEB_IMAGE=ghcr.io/your-org/hr-hcm-web:staging-latest
HCM_API_IMAGE=
HCM_WEB_IMAGE=
