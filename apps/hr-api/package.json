{
  "name": "@hcm/hr-api",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build && node ../../scripts/verify-tsc-output.mjs",
    "start": "pnpm exec dotenv -e ../../.env -- nest start",
    "start:dev": "pnpm exec dotenv -e ../../.env -- nest start --watch",
    "start:debug": "pnpm exec dotenv -e ../../.env -- nest start --debug --watch",
    "start:prod": "node dist/main",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "pnpm build && vitest run .e2e.test.ts .integration.test.ts --no-file-parallelism --passWithNoTests",
    "test:lifecycle": "pnpm build && vitest run test/runtime-lifecycle.e2e.test.ts --passWithNoTests",
    "test:watch": "vitest",
    "lint": "eslint src test --ext .ts && pnpm run lint:boundaries",
    "lint:boundaries": "depcruise --config .dependency-cruiser.cjs --ignore-known .dependency-cruiser-known-violations.json --include-only \"^src/domains\" src/domains"
  },
  "dependencies": {
    "@hcm/access-control": "workspace:*",
    "@hcm/command-contracts": "workspace:*",
    "@hcm/database": "workspace:*",
    "@hcm/event-schemas": "workspace:*",
    "@hcm/hr-intelligence": "workspace:*",
    "@hcm/openapi-contracts": "workspace:*",
    "@hcm/platform-core": "workspace:*",
    "@hcm/policy-engines": "workspace:*",
    "@hcm/shared-kernel": "workspace:*",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/common": "^11.1.29",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.29",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/platform-express": "^11.1.29",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/throttler": "^6.5.0",
    "@node-saml/node-saml": "^5.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.7.0",
    "cors": "^2.8.0",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.0",
    "kafkajs": "^2.2.4",
    "kysely": "^0.29.5",
    "multer": "^2.2.0",
    "openid-client": "^6.8.5",
    "otplib": "^13.4.1",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.3.0",
    "@types/bcrypt": "^5.0.0",
    "@types/compression": "^1.7.0",
    "@types/cors": "^2.8.0",
    "@types/express": "^4.17.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/multer": "^1.4.12",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.0",
    "dependency-cruiser": "^17.4.3",
    "supertest": "^7.2.2",
    "typescript": "^5.3.0",
    "vitest": "^1.6.0"
  }
}
