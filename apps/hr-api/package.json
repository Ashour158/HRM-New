{
  "name": "@hcm/hr-api",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start": "pnpm exec dotenv -e ../../.env -- nest start",
    "start:dev": "pnpm exec dotenv -e ../../.env -- nest start --watch",
    "start:debug": "pnpm exec dotenv -e ../../.env -- nest start --debug --watch",
    "start:prod": "node dist/main",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "vitest run .e2e.test.ts .integration.test.ts --passWithNoTests",
    "test:watch": "vitest",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\""
  },
  "dependencies": {
    "@hcm/access-control": "workspace:*",
    "@hcm/command-contracts": "workspace:*",
    "@hcm/database": "workspace:*",
    "@hcm/event-schemas": "workspace:*",
    "@hcm/openapi-contracts": "workspace:*",
    "@hcm/platform-core": "workspace:*",
    "@hcm/policy-engines": "workspace:*",
    "@hcm/shared-kernel": "workspace:*",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/cqrs": "^10.2.0",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/swagger": "^7.3.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.76.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/sdk-node": "^0.218.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.7.0",
    "cors": "^2.8.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.0",
    "jsonwebtoken": "^9.0.0",
    "kafkajs": "^2.2.4",
    "kysely": "^0.28.17",
    "otplib": "^13.4.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.3.0",
    "@types/bcrypt": "^5.0.0",
    "@types/compression": "^1.7.0",
    "@types/cors": "^2.8.0",
    "@types/express": "^4.17.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.3.0",
    "vitest": "^1.6.0"
  }
}
